# InsureIndex AI - Environment Configurations

# (Optional) Set your Gemini API key to enable high-fidelity natural language answering.
# If this key is not set, the RAG pipeline will fallback to a local rule-based extractor
# which yields 100% grounded facts with zero hallucinations.
GEMINI_API_KEY=your_gemini_api_key_here

# GOOGLE_API_KEY=your_gemini_api_key_here

# (Optional) Gemini model name. Change it when Google retires the default model.
# GEMINI_MODEL=gemini-3.8-flash

# (Optional) Sarvam AI key for natural "read aloud" voices in Indian languages.
# Without it, the read-aloud button uses the browser's own voices.
SARVAM_API_KEY=your_sarvam_api_key_here
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya

# (Optional) Set your Groq API key if you want to use Groq LLMs.
GROQ_API_KEY=your_groq_api_key_here

# (Optional) Point this to your specific PDF folder or zip file.
# If left empty, the server automatically scans "Policy Documents" in the project root.
# POLICY_DOCS_SOURCE=C:\Users\ADMIN\OneDrive\Documents\CAPSTONE\Policy Documents

# Request limit per client IP. Questions and PDF uploads count; read-aloud does not.
# RATE_LIMIT_REQUESTS=20            # 0 turns the limit off
# RATE_LIMIT_WINDOW_SECONDS=86400   # 24 hours

# Behind a proxy, every request seems to come from the proxy, so all users would share one limit.
# Cloudflare Worker (worker.js): set the same secret here and as a Worker secret named PROXY_SHARED_SECRET.
# PROXY_SHARED_SECRET=long_random_string
# Single reverse proxy that appends the client IP to X-Forwarded-For (for example Render):
# TRUST_X_FORWARDED_FOR=true
